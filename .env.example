# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real keys or topic names.

# Required — your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=your-key-here

# Required for Lesson 5's phone notifications — pick an unguessable topic
# name and subscribe to it in the ntfy app (https://ntfy.sh/) or a browser.
NTFY_TOPIC=pick-something-unguessable

# Optional — defaults to https://ntfy.sh if unset. Point at your own server
# once you self-host ntfy instead of using the public one.
# NTFY_SERVER=https://your-ntfy-server.example.com
